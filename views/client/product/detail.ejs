<!DOCTYPE html>
<html lang="vi">
  <head>
    <%- include('../layout/head', { pageTitle: product.name }); -%>
  </head>
  <body>
    <%- include('../layout/header'); -%>
    <%- include('../layout/search-modal'); -%>

    <main class="container py-5" style="margin-top: 180px">
      <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
          <li class="breadcrumb-item"><a href="/shop">Cửa hàng</a></li>
          <li class="breadcrumb-item active"><%= product.name %></li>
        </ol>
      </nav>

      <div class="row g-4">
        <div class="col-lg-6">
          <%- include('../layout/product-img', { product, imgClass: 'img-fluid rounded w-100', imgStyle: 'max-height:420px;object-fit:cover;' }); -%>
        </div>
        <div class="col-lg-6">
          <span class="badge bg-secondary text-dark mb-2"><%= product.factory %> · <%= product.target %></span>
          <h1 class="h2 text-primary"><%= product.name %></h1>
          <p class="text-muted"><%= product.shortDesc %></p>
          <p class="fs-4 fw-bold text-primary mb-4">
            <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(product.price) %>
          </p>
          <form action="/add-product-to-cart/<%= product.id %>" method="post" class="d-flex gap-2 flex-wrap">
            <input type="hidden" name="quantity" value="1" />
            <button type="submit" class="btn btn-primary px-4">
              <i class="fa fa-shopping-bag me-2"></i>Thêm vào giỏ
            </button>
            <a href="/shop" class="btn btn-outline-primary">Tiếp tục mua sắm</a>
          </form>
          <hr class="my-4" />
          <h5>Mô tả chi tiết</h5>
          <p class="mb-0"><%= product.detailDesc %></p>
        </div>
      </div>
    </main>

    <%- include('../layout/footer'); -%>
    <%- include('../layout/scripts'); -%>
  </body>
</html>
