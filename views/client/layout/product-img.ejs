<img
  src="/images/product/<%= product.image %>"
  class="<%= typeof imgClass !== 'undefined' ? imgClass : 'img-fluid w-100 product-thumb' %>"
  alt="<%= product.name %>"
  style="<%= typeof imgStyle !== 'undefined' ? imgStyle : 'height:220px;object-fit:cover;' %>"
  onerror="this.onerror=null;this.src='https://placehold.co/600x400/fce4ec/e91e8c?text=Hoa+tươi';"
/>
