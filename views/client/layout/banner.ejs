<div class="container-fluid py-5 mb-5 hero-header" style="margin-top: 160px">
  <div class="container py-5">
    <div class="row g-5 align-items-center">
      <div class="col-lg-7">
        <h4 class="mb-3 text-secondary">Hoa tươi mỗi ngày – Giao nhanh Hà Nội</h4>
        <h2 class="mb-4 display-4 text-primary fw-bold">Tươi mát • Ngọt ngào • Ý nghĩa</h2>
        <form class="position-relative mx-auto" method="get" action="/shop">
          <input
            class="form-control border-2 border-secondary w-75 py-3 px-4 rounded-pill"
            type="text"
            name="q"
            placeholder="Tìm bó hoa, giỏ hoa..."
            value="<%= typeof query !== 'undefined' && query.q ? query.q : '' %>"
          />
          <button
            type="submit"
            class="btn btn-primary border-2 border-secondary py-3 px-4 position-absolute rounded-pill text-white h-100"
            style="top: 0; right: 25%"
          >
            Tìm kiếm
          </button>
        </form>
      </div>
      <div class="col-lg-5 text-center">
        <div class="rounded-4 p-5 bg-white shadow-sm">
          <i class="fas fa-heart text-primary display-1 mb-3"></i>
          <p class="lead mb-0 text-muted">Hơn 50+ mẫu hoa cho sinh nhật, cưới hỏi, khai trương</p>
          <a href="/shop" class="btn btn-primary rounded-pill mt-3 px-4">Khám phá cửa hàng</a>
        </div>
      </div>
    </div>
  </div>
</div>
