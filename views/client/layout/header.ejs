<div class="container-fluid fixed-top">
  <div class="container topbar bg-primary d-none d-lg-block">
    <div class="d-flex justify-content-between">
      <div class="top-info ps-2">
        <small class="me-3">
          <i class="fas fa-map-marker-alt me-2 text-secondary"></i>
          <span class="text-white">31 Nguyên Xá, Bắc Từ Liêm, Hà Nội</span>
        </small>
        <small class="me-3">
          <i class="fas fa-envelope me-2 text-secondary"></i>
          <a href="mailto:contact@blossomflower.vn" class="text-white">contact@blossomflower.vn</a>
        </small>
      </div>
      <div class="top-link pe-2">
        <a href="/privacy" class="text-white"><small class="text-white mx-2">Chính sách bảo mật</small></a>/
        <a href="/terms" class="text-white"><small class="text-white mx-2">Điều khoản</small></a>/
        <a href="/purchase-policy" class="text-white"><small class="text-white ms-2">Chính sách mua hàng</small></a>
      </div>
    </div>
  </div>
  <div class="container px-0">
    <nav class="navbar navbar-light bg-white navbar-expand-xl">
      <a href="/" class="navbar-brand">
        <h1 class="text-primary display-6 mb-0"><i class="fas fa-spa me-1"></i> Blossom</h1>
      </a>
      <button class="navbar-toggler py-2 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
        <span class="fa fa-bars text-primary"></span>
      </button>
      <div class="collapse navbar-collapse bg-white" id="navbarCollapse">
        <div class="navbar-nav mx-auto">
          <a href="/" class="nav-item nav-link">Trang chủ</a>
          <a href="/shop" class="nav-item nav-link">Cửa hàng</a>
          <a href="/contact" class="nav-item nav-link">Liên hệ</a>
        </div>
        <div class="d-flex m-3 me-0">
          <button
            class="btn-search btn border border-secondary btn-md-square rounded-circle bg-white me-4"
            data-bs-toggle="modal"
            data-bs-target="#searchModal"
            type="button"
          >
            <i class="fas fa-search text-primary"></i>
          </button>
          <a href="/cart" class="position-relative me-4 my-auto">
            <i class="fa fa-shopping-bag fa-2x"></i>
            <span
              class="position-absolute bg-secondary rounded-circle d-flex align-items-center justify-content-center text-dark px-1 cart-count"
              style="top: -5px; left: 15px; height: 20px; min-width: 20px"
            ><%= user?.cart?.sum ?? 0 %></span>
          </a>
          <% if(user) { %>
          <div class="dropdown my-auto">
            <a href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fas fa-user fa-2x"></i>
            </a>
            <ul class="dropdown-menu dropdown-menu-end p-3">
              <li class="text-center mb-2 fw-semibold"><%= user.fullName %></li>
              <li><a class="dropdown-item" href="/order-history">Lịch sử mua hàng</a></li>
              <li><hr class="dropdown-divider" /></li>
              <li>
                <form method="post" action="/client/logout">
                  <button type="submit" class="dropdown-item">Đăng xuất</button>
                </form>
              </li>
            </ul>
          </div>
          <% } else { %>
          <a href="/client/login"><i class="fas fa-user fa-2x"></i></a>
          <% } %>
        </div>
      </div>
    </nav>
  </div>
</div>
