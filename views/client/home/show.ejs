<!DOCTYPE html>
<html lang="vi">
  <head>
    <%- include('../layout/head', { pageTitle: 'Trang chủ' }); -%>
  </head>
  <body>
    <div id="spinner" class="show w-100 vh-100 bg-white position-fixed translate-middle top-50 start-50 d-flex align-items-center justify-content-center">
      <div class="spinner-grow text-primary" role="status"></div>
    </div>

    <%- include('../layout/header'); -%>
    <%- include('../layout/search-modal'); -%>
    <%- include('../layout/banner'); -%>
    <%- include('../layout/feature'); -%>

    <section class="container-fluid py-5">
      <div class="container py-3">
        <div class="text-center mb-5">
          <h1 class="display-5 text-primary">Hoa tươi nổi bật</h1>
          <p class="text-muted">Chọn mẫu yêu thích và giao trong ngày tại Hà Nội</p>
        </div>
        <div class="row g-4">
          <% products.slice(0, 8).forEach(function(product) { %>
          <div class="col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm">
              <%- include('../layout/product-img', { product, imgClass: 'card-img-top product-thumb', imgStyle: 'height:200px;object-fit:cover;' }); -%>
              <div class="card-body">
                <span class="badge bg-secondary text-dark mb-2"><%= product.factory %></span>
                <h5 class="card-title">
                  <a href="/product/<%= product.id %>" class="text-dark text-decoration-none"><%= product.name %></a>
                </h5>
                <p class="card-text text-muted small"><%= product.shortDesc %></p>
                <p class="fw-bold text-primary mb-2">
                  <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(product.price) %>
                </p>
                <form method="post" action="/add-product-to-cart/<%= product.id %>">
                  <button class="btn btn-outline-primary btn-sm w-100">
                    <i class="fa fa-shopping-bag me-1"></i> Thêm vào giỏ
                  </button>
                </form>
              </div>
            </div>
          </div>
          <% }) %>
        </div>
        <div class="text-center mt-4">
          <a href="/shop" class="btn btn-primary rounded-pill px-4">Xem tất cả sản phẩm</a>
        </div>
      </div>
    </section>

    <section class="container-fluid banner bg-secondary my-5">
      <div class="container py-5">
        <div class="row g-4 align-items-center">
          <div class="col-lg-7">
            <h2 class="display-6 text-white">Ưu đãi cuối tuần</h2>
            <p class="text-white mb-4">Giảm 15% bó hoa sinh nhật khi đặt trước 12:00 thứ Bảy – Chủ nhật.</p>
            <a href="/shop?target=SINH-NHAT" class="btn btn-light rounded-pill px-4">Đặt hoa ngay</a>
          </div>
          <div class="col-lg-5 text-center">
            <i class="fas fa-seedling display-1 text-white opacity-75"></i>
          </div>
        </div>
      </div>
    </section>

    <%- include('../layout/footer'); -%>
    <%- include('../layout/scripts'); -%>
  </body>
</html>
