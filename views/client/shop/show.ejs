<!DOCTYPE html>
<html lang="vi">
  <head>
    <%- include('../layout/head', { pageTitle: 'Cửa hàng' }); -%>
  </head>
  <body>
    <%- include('../layout/header'); -%>
    <%- include('../layout/search-modal'); -%>

    <main class="container py-5" style="margin-top: 180px">
      <h1 class="text-primary mb-4">Cửa hàng hoa</h1>
      <div class="row">
        <aside class="col-md-3 mb-4">
          <form method="get" class="p-3 border rounded bg-white shadow-sm">
            <div class="mb-3">
              <label class="form-label">Khoảng giá</label>
              <select name="price" class="form-select">
                <option value="">Tất cả</option>
                <option value="0-300000" <%= query.price==="0-300000"?'selected':'' %>>Dưới 300.000đ</option>
                <option value="300000-600000" <%= query.price==="300000-600000"?'selected':'' %>>300k – 600k</option>
                <option value="600000-1000000" <%= query.price==="600000-1000000"?'selected':'' %>>600k – 1 triệu</option>
                <option value="1000000-5000000" <%= query.price==="1000000-5000000"?'selected':'' %>>Trên 1 triệu</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Loại hoa</label>
              <select name="factory" class="form-select">
                <option value="">Tất cả</option>
                <option value="HOA-HONG" <%= query.factory==="HOA-HONG"?'selected':'' %>>Hoa hồng</option>
                <option value="TULIP" <%= query.factory==="TULIP"?'selected':'' %>>Tulip</option>
                <option value="HOA-LY" <%= query.factory==="HOA-LY"?'selected':'' %>>Hoa ly</option>
                <option value="HOA-CUOI" <%= query.factory==="HOA-CUOI"?'selected':'' %>>Hoa cưới</option>
                <option value="HOA-MIX" <%= query.factory==="HOA-MIX"?'selected':'' %>>Mix theo mùa</option>
                <option value="KE-HOA" <%= query.factory==="KE-HOA"?'selected':'' %>>Kệ khai trương</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Dịp tặng</label>
              <select name="target" class="form-select">
                <option value="">Tất cả</option>
                <option value="SINH-NHAT" <%= query.target==="SINH-NHAT"?'selected':'' %>>Sinh nhật</option>
                <option value="TINH-YEU" <%= query.target==="TINH-YEU"?'selected':'' %>>Tình yêu</option>
                <option value="DAM-CUOI" <%= query.target==="DAM-CUOI"?'selected':'' %>>Đám cưới</option>
                <option value="KHAI-TRUONG" <%= query.target==="KHAI-TRUONG"?'selected':'' %>>Khai trương</option>
                <option value="VAN-PHONG" <%= query.target==="VAN-PHONG"?'selected':'' %>>Văn phòng</option>
                <option value="QUA-TANG" <%= query.target==="QUA-TANG"?'selected':'' %>>Quà tặng</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Từ khóa</label>
              <input type="text" name="q" class="form-control" value="<%= query.q||'' %>" placeholder="Tìm hoa..." />
            </div>
            <button class="btn btn-primary w-100">Lọc sản phẩm</button>
          </form>
        </aside>
        <section class="col-md-9">
          <div class="row g-4">
            <% if(products.length === 0){ %>
            <div class="col-12"><p class="text-muted">Không có sản phẩm phù hợp.</p></div>
            <% } %>
            <% products.forEach(function(product){ %>
            <div class="col-md-6 col-lg-4">
              <div class="card h-100 border-0 shadow-sm">
                <%- include('../layout/product-img', { product }); -%>
                <div class="card-body">
                  <h5 class="card-title"><a href="/product/<%= product.id %>" class="text-decoration-none text-dark"><%= product.name %></a></h5>
                  <p class="card-text small text-muted"><%= product.shortDesc %></p>
                  <p class="fw-bold text-primary"><%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(product.price) %></p>
                  <a href="/product/<%= product.id %>" class="btn btn-sm btn-outline-primary">Xem chi tiết</a>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
          <% if(totalPages > 1) { %>
          <nav class="mt-4" aria-label="Phân trang">
            <ul class="pagination justify-content-center">
              <% let start = Math.max(1, currentPage - 2);
                 let end = Math.min(totalPages, currentPage + 2);
                 for(let i=start;i<=end;i++){ %>
              <li class="page-item <%= i===currentPage?'active':'' %>">
                <a class="page-link" href="?page=<%= i %><% if(query.price){ %>&price=<%= query.price %><% } %><% if(query.factory){ %>&factory=<%= query.factory %><% } %><% if(query.target){ %>&target=<%= query.target %><% } %><% if(query.q){ %>&q=<%= encodeURIComponent(query.q) %><% } %>"><%= i %></a>
              </li>
              <% } %>
            </ul>
          </nav>
          <% } %>
        </section>
      </div>
    </main>

    <%- include('../layout/footer'); -%>
    <%- include('../layout/scripts'); -%>
  </body>
</html>
